OPENAI_API_KEY=your_openai_api_key_here
# Ambient assistant: required passcode for the voice page
ASSISTANT_ACCESS_CODE=choose_a_long_passcode
# Ambient assistant memory: Render Postgres internal URL, and a long random secret
# (use Render's Generate button; keep a copy, since changing it makes memories unreadable)
DATABASE_URL=postgresql://user:password@host/dbname
MEMORY_ENCRYPTION_KEY=generate_a_long_random_value
# Optional: ambient assistant voice settings
# REALTIME_MODEL=gpt-realtime
# REALTIME_VOICE=marin
# TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# SUMMARY_MODEL=gpt-5-mini
# EMBEDDING_MODEL=text-embedding-3-small
# SESSION_RETENTION_DAYS=90
# NOISE_REDUCTION=far_field  (use near_field for a headset)
